<%- include("partials/head") %>
<%- include("partials/nav") %>

<main>
  <div class="wrap">
    <h1>Credentials</h1>
    <p class="sub">
      Licence numbers, insurance, accreditations. These are the strongest trust signals on the
      site — publish only what you can evidence.
    </p>

    <% if (flash) { %><div class="flash"><%= flash %></div><% } %>
    <% if (error) { %><div class="flash err"><%= error %></div><% } %>

    <div class="card">
      <div class="inner">
        <h2>Add a credential</h2>
        <form method="post" action="/admin/credentials">
          <div class="row two">
            <div>
              <label for="label">Label</label>
              <input id="label" name="label" type="text" required
                     placeholder="e.g. Licensed in Washington" />
            </div>
            <div>
              <label for="detail">Detail</label>
              <input id="detail" name="detail" type="text"
                     placeholder="Licence number or issuing body" />
            </div>
          </div>

          <div class="row three">
            <div>
              <label for="icon">Icon</label>
              <select id="icon" name="icon">
                <%
                  // Must match the website's registry in src/components/icons.js —
                  // an unknown name renders nothing at all on the site.
                  const icons = ["ShieldCheck","BadgeCheck","Clock","ClipboardList",
                                 "HeartHandshake","Users","Activity","Stethoscope","Sparkles"];
                  icons.forEach(function (i) { %>
                    <option value="<%= i %>"><%= i %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <label for="expiresOn">Expires (optional)</label>
              <input id="expiresOn" name="expiresOn" type="date" />
            </div>
            <div>
              <label for="sortOrder">Order</label>
              <input id="sortOrder" name="sortOrder" type="number" value="0" />
            </div>
          </div>

          <div class="check">
            <input id="published" name="published" type="checkbox" />
            <label for="published">Publish on the website now</label>
          </div>

          <button class="btn btn-primary" type="submit" style="margin-top:10px">
            Add credential
          </button>
        </form>
      </div>
    </div>

    <div class="card">
      <% if (!items.length) { %>
        <div class="empty">
          <p style="margin:0 0 6px"><strong>No credentials yet.</strong></p>
          <p class="muted" style="margin:0">
            Washington state licence number, bonded/insured status, and your caregiver
            background-check policy are the three families ask about most.
          </p>
        </div>
      <% } else { %>
        <div style="overflow-x:auto">
          <table>
            <thead>
              <tr><th>Label</th><th>Detail</th><th>Expires</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
              <% items.forEach(function (c) { %>
                <%
                  const expired = c.expiresOn && new Date(c.expiresOn).getTime() < Date.now();
                %>
                <tr>
                  <td><strong><%= c.label %></strong><br /><span class="muted"><%= c.icon %></span></td>
                  <td><%= c.detail || "—" %></td>
                  <td>
                    <% if (!c.expiresOn) { %><span class="muted">—</span>
                    <% } else { %>
                      <span class="<%= expired ? '' : 'muted' %>"
                            style="<%= expired ? 'color:var(--danger);font-weight:600' : '' %>">
                        <%= new Date(c.expiresOn).toLocaleDateString("en-US",
                            { year:"numeric", month:"short", day:"numeric" }) %>
                        <%= expired ? " (expired)" : "" %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <span class="pill <%= c.published ? 'badge-on' : 'badge-off' %>">
                      <%= c.published ? "live" : "draft" %>
                    </span>
                  </td>
                  <td style="text-align:right;white-space:nowrap">
                    <form method="post" action="/admin/credentials/<%= c._id %>/toggle"
                          style="display:inline">
                      <button class="btn btn-ghost btn-sm" type="submit">
                        <%= c.published ? "Unpublish" : "Publish" %>
                      </button>
                    </form>
                    <form method="post" action="/admin/credentials/<%= c._id %>/delete"
                          style="display:inline"
                          onsubmit="return confirm('Delete this credential?')">
                      <button class="btn-danger" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

</body>
</html>
