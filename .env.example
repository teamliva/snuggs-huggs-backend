# Copy to backend/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────────────
# Local install:  mongodb://127.0.0.1:27017/snuggs-huggs
# MongoDB Atlas:  mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/snuggs-huggs
MONGODB_URI=mongodb://127.0.0.1:27017/snuggs-huggs

# ── Security ─────────────────────────────────────────────────────────
# Signs admin session cookies. Must be 32+ characters and secret — anyone
# holding it can mint a valid admin session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# How long an admin stays signed in.
SESSION_HOURS=12

# Browser origins allowed to call the public API (comma-separated).
# Add the production domain before going live.
CORS_ORIGINS=http://localhost:3000,https://snuggsandhuggsseniorservices.com

# ── Email notifications (optional) ───────────────────────────────────
# If SMTP_HOST and MAIL_TO are unset, new leads are still saved — they're
# just logged to the console instead of emailed. Nothing breaks.
#
# Hostinger example:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Snuggs & Huggs Website <noreply@snuggsandhuggsseniorservices.com>"
MAIL_TO=

# ── Blog image uploads ───────────────────────────────────────────────
# Leave unset for local dev — uploads fall back to local disk (./uploads).
# On Vercel, enable Blob storage on the project (Storage tab) and it sets
# this automatically; local disk doesn't persist there.
BLOB_READ_WRITE_TOKEN=
